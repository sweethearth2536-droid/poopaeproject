rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidPatient(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && data.age is int && data.age >= 0 && data.age <= 150
          && data.gender is string && data.gender.size() <= 20
          && data.bloodType is string && data.bloodType.size() <= 10
          && data.heartRate is int && data.heartRate >= 0
          && data.bloodPressure is string && data.bloodPressure.size() <= 20
          && data.status is string && data.status.size() <= 50;
    }
    
    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128
          && data.patientId is string && data.patientId.size() <= 128
          && data.text is string && data.text.size() <= 5000
          && data.timeTag is string && data.timeTag.size() <= 100
          && data.createdAt is string && data.createdAt.size() <= 100
          && data.caregiverName is string && data.caregiverName.size() <= 200;
    }
    
    function isValidMedication(data) {
      return data.id is string && data.id.size() <= 128
          && data.patientId is string && data.patientId.size() <= 128
          && data.time is string && data.time.size() <= 20
          && data.name is string && data.name.size() <= 200
          && data.instructions is string && data.instructions.size() <= 1000
          && data.status is string && data.status.size() <= 50;
    }
    
    function isValidSchedule(data) {
      return data.id is string && data.id.size() <= 128
          && data.patientId is string && data.patientId.size() <= 128
          && data.title is string && data.title.size() <= 200
          && data.location is string && data.location.size() <= 500
          && data.date is string && data.date.size() <= 20
          && data.time is string && data.time.size() <= 20;
    }
    
    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128
          && data.senderUid is string && data.senderUid.size() <= 128
          && data.senderName is string && data.senderName.size() <= 200
          && data.text is string && data.text.size() <= 5000
          && data.timestamp is string && data.timestamp.size() <= 100;
    }
    
    function isValidStatusUpdate(data) {
      return data.id is string && data.id.size() <= 128
          && data.text is string && data.text.size() <= 5000
          && data.createdAt is string && data.createdAt.size() <= 100
          && data.postedBy is string && data.postedBy.size() <= 200;
    }

    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidPatient(request.resource.data);
      
      match /notes/{noteId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidNote(request.resource.data);
      }
    }
    
    match /medications/{medicationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidMedication(request.resource.data);
    }
    
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSchedule(request.resource.data);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidMessage(request.resource.data);
    }
    
    match /statusUpdates/{statusUpdateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidStatusUpdate(request.resource.data);
    }
  }
}
